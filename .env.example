# Ansök AI landing page – environment variables.
#
# Copy this file to .env.local for local development, or set the variables in
# your host's dashboard (e.g. Vercel). Every value is OPTIONAL: the site falls
# back to clearly labelled placeholders while a value is missing, so nothing
# breaks without them. NEXT_PUBLIC_* values are inlined at BUILD time – rebuild
# and redeploy after changing any of them. See README.md for details.

# The real production domain, https only (e.g. https://ansokai.se).
# Enables the canonical URL and absolute social-sharing image URLs.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as an automatic fallback.
# Without it, the build warns and the page stays noindex.
NEXT_PUBLIC_SITE_URL=

# Explicit opt-in for search-engine indexing at the PUBLIC LAUNCH only.
# Anything other than "true" keeps every response noindex/nofollow
# (robots meta tag, X-Robots-Tag header, robots.txt and an empty sitemap).
# Also requires a valid NEXT_PUBLIC_SITE_URL.
ALLOW_INDEXING=

# The CEO's booking page (Calendly, Cal.com, …), https URLs only.
# When set, every "Boka Möte Med Vår VD" button opens it in a new tab.
NEXT_PUBLIC_BOOKING_URL=

# Approved contact address for meeting requests. Used only when no booking URL
# is set: the #boka-mote section then offers a pre-filled e-mail draft.
# With neither value, the section states honestly that booking is not open yet.
NEXT_PUBLIC_CONTACT_EMAIL=

# Official product video: a normal YouTube/Vimeo link (converted to a
# privacy-friendly embed) or a local file under public/ (e.g. /assets/demo.mp4).
# While unset, a clearly labelled temporary illustration video is shown instead
# (see site.video.temporary in lib/site.ts).
NEXT_PUBLIC_VIDEO_URL=
